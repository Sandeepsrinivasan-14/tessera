# Copy to `.env` and fill in. `.env` is git-ignored; never commit real credentials.

# --- Remote mode (default) ---------------------------------------------------
PATIENT_API_STUDENT_ID=
PATIENT_API_PASSWORD=
PATIENT_API_SET=setA
PATIENT_API_BASE_URL=https://t4e-testserver.onrender.com/api

# --- Tuning (optional) --------------------------------------------------------
PATIENT_API_TIMEOUT=45
PATIENT_API_RETRIES=3
PATIENT_API_CACHE_TTL=60

# --- Offline mode -------------------------------------------------------------
# Set this and no network call is made; credentials are not required.
# PATIENT_API_DATA_FILE=data/sample_patients.json
